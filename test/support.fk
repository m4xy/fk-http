import fckt.io.Reader
import fckt.text.Encodings.*

reading<A>(text: String, body: @Reader () -> A): A = {
  var rest = text
  Reader(
    nextLine = () -> if (rest.isEmpty()) None else {
      line = rest.substringBefore("\n")
      rest = rest.drop(line.length + 1)
      Some(line)
    },
    nextBytes = count -> {
      taken = if (count < 0) rest else rest.take(count)
      rest = rest.drop(taken.length)
      taken.encodeToBytes()
    },
  ) { body() }
}

expectContains(text: String, part: String): Unit = if (!text.contains(part)) error("expected to find:\n$part\nin:\n$text")
