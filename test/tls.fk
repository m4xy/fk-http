import fckt.effects.Fail
import uk.m4xy.fktests.api.Test
import uk.m4xy.http.*
import uk.m4xy.http.Messages.*
import uk.m4xy.http.Statuses.*
import uk.m4xy.http.client.*
import uk.m4xy.http.net.Network

// Over the internet, so these need it: example.com, and badssl.com's hosts, whose certificates
// are wrong on purpose.

// An https URL is sent through TLS, and what comes back is read as it is over plain HTTP.
@Test @Fail @Network @Http httpsIsSentThroughTls() = {
  response = Client.get("https://example.com/")
  assertEquals(ok, response.status)
  expectContains(response.text, "Example Domain")
}

// A host whose certificate the machine doesn't trust, or that isn't the host's, isn't answered.
@Test @Network @Http aCertificateThatIsntTrustedIsRefused() = {
  assertEquals(Error("expired.badssl.com's certificate isn't trusted: certificate has expired"), statusOf("expired.badssl.com"))
  assertEquals(Error("wrong.host.badssl.com's certificate isn't trusted: hostname mismatch"), statusOf("wrong.host.badssl.com"))
  assertEquals(Error("self-signed.badssl.com's certificate isn't trusted: self-signed certificate"), statusOf("self-signed.badssl.com"))
}

@Network @Http private statusOf(host: String): Result<Status, String> = Http.send(Request(Get, Url(Https, host, 443))).map { it.status }
