import fckt.text.Bytes
import fckt.text.Encodings.*
import uk.m4xy.http.Headers.*

module Messages {
  text(status: Status, text: String): Response =
    Response(status, [Header("Content-Type", "text/plain; charset=utf-8")], text.encodeToBytes())

  Response.text: String = this.body.decodeToString()

  Response.header(name: String): Option<String> = this.headers.valueOf(name)

  Request.text: String = this.body.decodeToString()

  Request.header(name: String): Option<String> = this.headers.valueOf(name)
}
