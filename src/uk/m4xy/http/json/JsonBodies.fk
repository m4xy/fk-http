import fckt.effects.Fail
import fckt.text.Encodings.*
import uk.m4xy.serialization.Serializer
import uk.m4xy.serialization.json.Json
import uk.m4xy.http.*
import uk.m4xy.http.Headers.*
import uk.m4xy.http.Messages.*
import uk.m4xy.http.Statuses.*
import uk.m4xy.http.client.*
import uk.m4xy.http.server.Call
import uk.m4xy.http.server.Input
import uk.m4xy.http.server.InputPart
import uk.m4xy.http.server.Route
import uk.m4xy.http.server.RouteAnswer
import fckt.monads.Validation

module JsonBodies {
  mediaType: String = "application/json"

  json(status: Status, serializer: Serializer, value: serializer.T): Response =
    Response(
      status,
      [Header("Content-Type", mediaType)],
      Json.encode(serializer, value).encodeToBytes(),
    )

  @Fail Response.json(serializer: Serializer): serializer.T = when (Json.decode(serializer, this.text)) {
    Ok(value) -> value
    Error(reason) -> fail("the response from the server isn't what was asked for: $reason")
  }

  Request.json(serializer: Serializer): Result<serializer.T, String> = Json.decode(serializer, this.text)

  body(serializer: Serializer): Input<serializer.T> = Input([], call -> when (call.request.json(serializer)) {
    Ok(value) -> Valid(value)
    Error(reason) -> Invalid([reason])
  }, [JsonBodyPart(serializer.describe())])

  Route<@E>.answeringJson<@E>(status: Status, serializer: Serializer): Route<@E> =
    this.copy(answers = this.answers + [RouteAnswer(status, Some(serializer.describe()))])

  receiving<@E>(call: Call, serializer: Serializer, respond: @E (serializer.T) -> Response): Response = when (call.request.json(serializer)) {
    Ok(value) -> respond(value)
    Error(reason) -> text(badRequest, reason)
  }

  @Http @Fail postJson(url: String, serializer: Serializer, value: serializer.T): Response =
    Client.post(url, Json.encode(serializer, value).encodeToBytes(), mediaType)

  @Http @Fail putJson(url: String, serializer: Serializer, value: serializer.T): Response =
    Client.send(
      Request(
        Put,
        Client.parsed(url),
        [Header("Content-Type", mediaType)],
        Json.encode(serializer, value).encodeToBytes(),
      ),
    )
}
