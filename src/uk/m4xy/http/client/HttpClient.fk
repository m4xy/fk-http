import fckt.effects.Fail
import fckt.effects.Failure.attempt
import uk.m4xy.http.*
import uk.m4xy.http.net.*
import uk.m4xy.http.wire.Wire

// Sends a request over a connection of its own, through TLS for an https URL, which is closed once
// the response is read.
module HttpClient : Http {
  @Network send(request: Request): Result<Response, String> = {
    url = request.url
    when (connect(url.host, url.port, security(url.scheme))) {
      Error(reason) -> Error(reason)
      Ok(connection) -> {
        answered = attempt {
          when (Network.send(connection, Wire.requestBytes(request))) {
            Ok(_) -> Connections.reading(connection) { Wire.readResponse(request.method) }
            Error(reason) -> fail(reason)
          }
        }
        close(connection)
        answered
      }
    }
  }

  private security(scheme: Scheme): Security = when (scheme) {
    Http -> Plain
    Https -> Tls
  }
}
