import fckt.effects.Fail
import fckt.effects.Failure.attempt
import uk.m4xy.http.*
import uk.m4xy.http.Statuses.*
import uk.m4xy.http.net.*
import uk.m4xy.http.wire.Wire
import uk.m4xy.http.client.Http

// Serving routes: over the network, a connection at a time, or to requests a program sends itself.
module Server {
  // Serves routes on port until the program ends.
  @Network @Fail serve<@E>(port: Int, routes: List<Route<@E>>): Nothing = when (listen(port)) {
    Ok(listener) -> forever(listener, routes)
    Error(reason) -> fail(reason)
  }

  // Accepts the next connection to listener, answers its request, and closes it: a request that
  // isn't HTTP is answered 400.
  @Network handleNext<@E>(listener: Listener, routes: List<Route<@E>>): Unit = when (accept(listener)) {
    Error(_) -> Unit
    Ok(connection) -> {
      response = when (attempt { Connections.reading(connection) { Wire.readRequest() } }) {
        Ok(Some(request)) -> Some(Routes.respond(routes, request))
        Ok(None) -> None
        Error(reason) -> Some(Messages.text(badRequest, reason))
      }
      // A client that's gone before it's answered has nothing to be told.
      response.forEach { r -> when (Network.send(connection, Wire.responseBytes(r))) { _ -> Unit } }
      close(connection)
    }
  }

  // Runs body with the requests it sends answered by routes, as a server of them would, without
  // the network: to test a client and server together. It's @Network only as anything that does
  // @Http is.
  @Network answering<@E, A>(routes: List<Route<@E>>, body: @Http () -> A): A =
    Http(send = request -> Ok(Routes.respond(routes, request))) { body() }

  @Network private forever<@E>(listener: Listener, routes: List<Route<@E>>): Nothing = {
    handleNext(listener, routes)
    forever(listener, routes)
  }
}
