import fckt.effects.Fail
import fckt.effects.Failure.attempt
import uk.m4xy.http.*
import uk.m4xy.http.Statuses.*
import uk.m4xy.http.net.*
import uk.m4xy.http.wire.Wire
import uk.m4xy.http.client.Http
import fckt.concurrent.*
import fckt.io.Polls
import fckt.io.Polling
import fckt.time.Clock
import fckt.time.Duration

module Server {
  @Fail @Clock serve<@E>(
    port: Int,
    routes: List<Route<@E>>,
    timeout: Duration = Duration(30000),
    executor: Executor = InTurn,
  ): Nothing = {
    router = when (Routers.of(routes)) {
      Ok(r) -> r
      Error(why) -> fail("can't serve the routes: $why")
    }
    Polls.running(executor) {
      PolledSockets.running(timeout) {
        when (listen(port)) {
          Ok(listener) -> forever(listener, router, timeout)
          Error(reason) -> fail(reason)
        }
      }
    }
  }

  @Network handleNext<@E>(
    listener: Listener,
    routes: List<Route<@E>>,
  ): Unit = when (accept(listener)) {
    Error(_) -> Unit
    Ok(connection) -> answer(connection, request -> Routes.respond(routes, request))
  }

  @Network private answer<@E>(connection: Connection, respond: @E (Request) -> Response): Unit = {
    response = when (attempt { Connections.reading(connection) { Wire.readRequest() } }) {
      Ok(Some(request)) -> Some(respond(request))
      Ok(None) -> None
      Error(reason) -> Some(Messages.text(badRequest, reason))
    }
    response.forEach { r -> when (Network.send(connection, Wire.responseBytes(r))) { _ -> Unit } }
    close(connection)
  }

  @Network answering<@E, A>(routes: List<Route<@E>>, body: @Http () -> A): A = {
    router = Routers.of(routes)
    Http(send = request -> Ok(when (router) {
      Ok(r) -> Routers.respond(r, request)
      Error(why) -> Messages.text(internalServerError, "can't serve the routes: $why")
    })) { body() }
  }

  @Network @Concurrent<@Polling @Clock @E> @Polling private forever<@E>(
    listener: Listener,
    router: Router<@E>,
    timeout: Duration,
  ): Nothing = {
    when (accept(listener)) {
      Ok(connection) -> {
        launch { PolledSockets.running(timeout) { answer(connection, request -> Routers.respond(router, request)) } }
        Unit
      }
      Error(_) -> Unit
    }
    forever(listener, router, timeout)
  }
}
