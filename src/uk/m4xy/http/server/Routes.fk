import fckt.effects.Fail
import uk.m4xy.http.*
import uk.m4xy.http.Messages.*
import uk.m4xy.http.Statuses.*

// Answering requests with routes.
module Routes {
  // The response of the route for the request's method and path, as Routers.respond gives it; 500 if
  // the routes can't be served together, saying why.
  respond<@E>(routes: List<Route<@E>>, request: Request): Response = when (Routers.of(routes)) {
    Ok(router) -> Routers.respond(router, request)
    Error(why) -> text(internalServerError, why)
  }

  // The routes, each under prefix: /links/{slug} mounted at /api is /api/links/{slug}. Each part of
  // a service can say its own routes, and the service mount them together.
  mounted<@E>(prefix: String, routes: List<Route<@E>>): List<Route<@E>> =
    routes.map { it.copy(path = prefix.removeSuffix("/") + (if (it.path == "/") "" else it.path)) }

  // The routes, each answering inside around: what they do that around handles, they're answered
  // with. A handler's operations are answered where the handler is, so what's to be handled for
  // each request, as a database's links, is handled around it, inside the route, so that if it
  // fails, that request is answered 500, not every one after it:
  //
  //   Routes.around(routes) { respond -> SqliteLinks.keeping { respond() } }
  around<@E, @F>(routes: List<Route<@E>>, around: @Fail @F (@Fail @E () -> Response) -> Response): List<Route<@F>> =
    routes.map { route ->
      respond = route.respond
      Route(route.method, route.path, call -> around { respond(call) })
    }

  // The route, described as answering with status and nothing more.
  Route<@E>.answering<@E>(status: Status): Route<@E> = this.copy(answers = this.answers + [RouteAnswer(status, None)])

  // The route, described in a few words.
  Route<@E>.summarised<@E>(summary: String): Route<@E> = this.copy(summary = Some(summary))
}
