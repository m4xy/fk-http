import uk.m4xy.http.*
import uk.m4xy.http.Messages.*
import uk.m4xy.http.Statuses.*

// Answering requests with routes.
module Routes {
  // The response of the route for the request's method and path, as Routers.respond gives it; 500 if
  // the routes can't be served together, saying why.
  respond<@E>(routes: List<Route<@E>>, request: Request): Response = when (Routers.of(routes)) {
    Ok(router) -> Routers.respond(router, request)
    Error(why) -> text(internalServerError, why)
  }

  // The routes, each under prefix: /links/{slug} mounted at /api is /api/links/{slug}. Each part of
  // a service can say its own routes, and the service mount them together.
  mounted<@E>(prefix: String, routes: List<Route<@E>>): List<Route<@E>> =
    routes.map { it.copy(path = prefix.removeSuffix("/") + (if (it.path == "/") "" else it.path)) }
}
