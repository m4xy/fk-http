import fckt.effects.Failure.attempt
import fckt.collections.Maps.*
import fckt.collections.Maps.Map
import uk.m4xy.http.*
import uk.m4xy.http.Messages.*
import uk.m4xy.http.Statuses.*

module Routers {
  of<@E>(routes: List<Route<@E>>): Result<Router<@E>, String> = {
    root = routes.fold(empty()) { node, route -> added(node, segments(route.path), route) }
    when (clashes(root)) {
      [] -> Ok(Router(root))
      found -> Error(found.joinToString("; "))
    }
  }

  respond<@E>(router: Router<@E>, request: Request): Response = {
    path = segments(request.url.path)
    ends = endsOf(router.root, path)
    when (ends.flatMap { it.routes }.find { it.method == request.method }) {
      Some(route) -> {
        respond = route.respond
        when (attempt { respond(Call(request, paramsOf(segments(route.path), path, emptyMap()))) }) {
          Ok(response) -> response
          Error(reason) -> text(internalServerError, reason)
        }
      }
      None if ends.isEmpty() -> text(notFound, "nothing is at ${request.url.path}")
      None -> {
        allowed = ends.flatMap { it.routes }.map { MethodText.of(it.method) }.distinct().joinToString(", ")
        text(methodNotAllowed, "${request.url.path} takes $allowed").copy(headers = [Header("Allow", allowed)])
      }
    }
  }

  segments(path: String): List<String> = when (path.split("/")) {
    ["", *rest] -> rest
    all -> all
  }

  isParam(segment: String): Boolean = segment.startsWith("{") && segment.endsWith("}")

  private empty<@E>(): RouteNode<@E> = RouteNode([], emptyMap(), None)

  private added<@E>(node: RouteNode<@E>, path: List<String>, route: Route<@E>): RouteNode<@E> = when (path) {
    [] -> node.copy(routes = node.routes + [route])
    [segment, *rest] if isParam(segment) -> node.copy(param = Some(added(node.param.getOrElse(empty()), rest, route)))
    [segment, *rest] -> node.copy(fixed = node.fixed.put(segment, added(node.fixed.get(segment).getOrElse(empty()), rest, route)))
  }

  private clashes<@E>(node: RouteNode<@E>): List<String> = {
    here = node.routes.mapIndexed { i, route ->
      node.routes.drop(i + 1).filter { it.method == route.method }.map { other ->
        "${MethodText.of(route.method)} ${route.path} and ${other.path} match the same requests"
      }
    }.flatten()
    here + node.fixed.toList().flatMap { _, next -> clashes(next) } + node.param.map { clashes(it) }.getOrElse([])
  }

  private endsOf<@E>(node: RouteNode<@E>, path: List<String>): List<RouteNode<@E>> = when (path) {
    [] -> if (node.routes.isEmpty()) [] else [node]
    [segment, *rest] ->
      node.fixed.get(segment).map { endsOf(it, rest) }.getOrElse([]) +
        (if (segment.isEmpty()) [] else node.param.map { endsOf(it, rest) }.getOrElse([]))
  }

  private paramsOf(pattern: List<String>, path: List<String>, params: Map<String, String>): Map<String, String> = when (pattern, path) {
    ([p, *ps], [s, *ss]) -> paramsOf(ps, ss, if (isParam(p)) params.put(p.drop(1).dropLast(1), s) else params)
    _ -> params
  }
}
